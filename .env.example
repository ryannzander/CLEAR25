# Copy this file to .env and fill in the values you actually need.
# Anything left commented falls back to the safe default.

# ── Core ─────────────────────────────────────────────────────────────────────
# DEBUG=true is the only safe shortcut: it auto-supplies the dev SECRET_KEY,
# enables SQLite, relaxes ALLOWED_HOSTS, and is the only mode the test endpoint
# (/api/v1/subscribe/test/) responds in.
DEBUG=true

# Required when DEBUG=false. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# SECRET_KEY=

# Required when DEBUG=false. Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_URL=

# Optional Redis for cache + sessions. Falls back to in-memory locmem.
# REDIS_URL=redis://localhost:6379/0

# ── Hosts / CORS / CSRF ──────────────────────────────────────────────────────
# Comma-separated. ALLOWED_HOSTS already includes clear25.xyz / www.clear25.xyz.
# ALLOWED_HOSTS=staging.clear25.xyz
# CORS_ALLOWED_ORIGINS=https://app.example.com
# CSRF_TRUSTED_ORIGINS=https://app.example.com
# Vercel previews scoped to your project (no wildcard *.vercel.app):
# VERCEL_HOST_PREFIX=clear25

# ── Auth (Google OAuth) ──────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# In DEBUG, email goes to the console. To force-test verification email locally,
# set ACCOUNT_EMAIL_VERIFICATION=optional or none while iterating.
# ACCOUNT_EMAIL_VERIFICATION=mandatory

# ── Email (allauth verification etc.) — only used when DEBUG=false ───────────
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=no-reply@clear25.xyz

# ── Data refresh ─────────────────────────────────────────────────────────────
# WAQI_API_TOKEN=
# Required by /api/refresh/ (cron) and /api/v1/subscribe/test/ (DEBUG only).
# CRON_SECRET=

# ── Billing (NOWPayments) ────────────────────────────────────────────────────
# NOWPAYMENTS_SANDBOX=true
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
# NOWPAYMENTS_SANDBOX_API_KEY=
# NOWPAYMENTS_SANDBOX_IPN_SECRET=

# ── Health check ─────────────────────────────────────────────────────────────
# When set, callers presenting X-Healthcheck-Token: <this> get per-component
# diagnostics from /health/. Public callers always get a one-word status.
# HEALTHCHECK_TOKEN=

# ── Push (iOS APNs) ──────────────────────────────────────────────────────────
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=com.clear25.app
# APNS_KEY_CONTENT=
# APNS_SANDBOX=false

# ── TLS / HSTS (production) ──────────────────────────────────────────────────
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_PRELOAD=false
# MAX_REQUEST_BODY_BYTES=1048576
# IP_RATE_LIMIT_REQUESTS=30
# IP_RATE_LIMIT_WINDOW_SECONDS=60
