[Unit]
Description=CLEAR smoke dashboard (static server on :8077)
After=network-online.target
Wants=network-online.target

[Service]
# >>> EDIT these two paths to match your install <<<
WorkingDirectory=/home/pi/CLEAR25/smoke_pi
ExecStart=/home/pi/CLEAR25/.venv/bin/python serve.py --port 8077
# Free CARTO basemap key (https://carto.com/basemaps/apikey/); without it the
# map tiles carry an "API KEY REQUIRED" watermark.
#Environment=CARTO_BASEMAPS_KEY=your-key-here
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
